<Window x:Class="AcsEditor.EditorCommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        Width="720" Height="520"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource Win}"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="12"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border BorderBrush="{StaticResource CtrlBorder}" BorderThickness="1"
            Background="{StaticResource Win}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="38" Background="{StaticResource Panel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Accent}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="COMMAND PALETTE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock Text="  ·  editor actions" FontSize="11"
                               Foreground="{StaticResource TextDim}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Width="40" Height="30"
                        Margin="0,4,4,4" Padding="0" Click="OnClose"/>
            </Grid>

            <Grid Grid.Row="1" Margin="14,14,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⌕" FontSize="22" Margin="3,0,10,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                <TextBox x:Name="QueryBox" Grid.Column="1" Height="38"
                         Padding="10,6" FontSize="14"
                         ToolTip="Type an action, category, or shortcut"
                         TextChanged="OnQueryChanged"/>
            </Grid>

            <Grid Grid.Row="2" Margin="14,0,14,10">
                <ListBox x:Name="ResultsList"
                         Background="{StaticResource Panel}"
                         BorderBrush="{StaticResource Hairline}"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnResultDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource Hairline}"
                                                BorderThickness="0,0,0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{StaticResource CtrlHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{StaticResource AccentDim}"/>
                                                <Setter TargetName="Row" Property="BorderBrush"
                                                        Value="{StaticResource Accent}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.42"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="CommandRow" Margin="12,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Label}" FontSize="13"
                                               Foreground="{StaticResource Text}"/>
                                    <TextBlock Text="{Binding Description}" Margin="0,3,0,0"
                                               FontSize="10.5" Foreground="{StaticResource TextDim}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Border Background="{StaticResource Ctrl}" Padding="6,2"
                                            Margin="0,0,8,0" BorderBrush="{StaticResource CtrlBorder}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                   Foreground="{StaticResource TextDim}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Shortcut}" MinWidth="72"
                                               TextAlignment="Right" FontSize="10.5"
                                               Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter TargetName="CommandRow" Property="Opacity" Value="0.42"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="EmptyState" Visibility="Collapsed"
                        Background="{StaticResource Panel}" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="No matching editor action" FontSize="14"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Try a command name, category, or shortcut."
                                   Margin="0,6,0,0" Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Height="34" Background="{StaticResource Panel2}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="14,0" VerticalAlignment="Center"
                           Text="↑ ↓ navigate   Enter run   Esc close"
                           FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                <TextBlock x:Name="ResultCountText" Grid.Column="1" Margin="14,0"
                           VerticalAlignment="Center" FontSize="10.5"
                           Foreground="{StaticResource TextDim}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
