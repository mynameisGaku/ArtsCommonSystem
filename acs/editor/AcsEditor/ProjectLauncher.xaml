<Window x:Class="AcsEditor.ProjectLauncher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACS Project Browser"
        Height="620" Width="920" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Win}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="12"
        ResizeMode="CanResize"
        UseLayoutRounding="True">
    <Grid x:Name="LauncherContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="3" Height="26" Background="{DynamicResource Accent}" Margin="0,0,11,0"/>
                    <StackPanel>
                        <TextBlock Text="ACS PROJECT BROWSER" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Select a workspace or create one." FontSize="11"
                                   Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="OpenExistingBtn" Grid.Column="1"
                        Content="Open Existing…" Click="OnOpenExisting"
                        Style="{DynamicResource ToolbarButton}" MinWidth="126"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="18,16,17,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="RECENT PROJECTS" Style="{DynamicResource Section}"/>
                    <TextBlock x:Name="RecentCountText" HorizontalAlignment="Right"
                               Style="{DynamicResource StateLabel}"/>
                </Grid>
                <ListBox x:Name="RecentsList" Grid.Row="1" Margin="0,8,0,10"
                         MouseDoubleClick="OnRecentDoubleClick"
                         SelectionChanged="OnRecentSelectionChanged"
                         KeyDown="OnRecentKeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="9,7"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextDim}"
                                               FontFamily="Consolas" FontSize="10.5"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,8,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource WarnFg}"
                                           FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button x:Name="OpenRecentBtn" Content="Open Selected" Click="OnOpenRecent"
                            Style="{DynamicResource ToolbarButton}" MinWidth="112" IsEnabled="False"/>
                    <TextBlock Text="Enter or double-click to open" Style="{DynamicResource StateLabel}"
                               Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Background="{DynamicResource Hairline}"/>

            <Grid Grid.Column="2" Margin="18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="NEW PROJECT" Style="{DynamicResource Section}"/>

                <StackPanel Grid.Row="1" Margin="0,13,0,0">
                    <TextBlock Text="Name" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="NameBox" Text="MyGame" Height="27"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="Location" Style="{DynamicResource FieldLabel}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LocationBox" Height="27"/>
                        <Button x:Name="BrowseLocationBtn" Grid.Column="1" Content="…" Width="32"
                                Margin="5,0,0,0" Click="OnBrowseLocation"/>
                    </Grid>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Template" Style="{DynamicResource FieldLabel}" Margin="0,14,0,5"/>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="Tpl3D" Grid.Column="0" Content="3D" IsChecked="True"
                                  Height="32" Click="OnPickTemplate" Tag="3d"
                                  ToolTip="Create an empty 3D world"/>
                    <ToggleButton x:Name="Tpl2D" Grid.Column="2" Content="2D (Orthographic)"
                                  Height="32" Click="OnPickTemplate" Tag="2d"
                                  ToolTip="Create a 3D world with the XY Orthographic editing preset"/>
                </Grid>

                <Button x:Name="CreateBtn" Grid.Row="6" Content="Create Project" Height="34"
                        Click="OnCreate" FontWeight="SemiBold"
                        Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}"
                        Foreground="White"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Style="{DynamicResource StateLabel}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="CloseBtn" Content="Close"
                        HorizontalAlignment="Right" Click="OnCancel"
                        Background="Transparent" BorderThickness="0" Padding="10,2"/>
            </Grid>
        </Border>
    </Grid>
</Window>
