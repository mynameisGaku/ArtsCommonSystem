<Window x:Class="AcsEditor.SceneRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scene Recovery"
        Width="580" Height="360" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Win}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="12">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Unsaved scene recovery found"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="ACS closed before this document was saved. The source scene has not been modified."
                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,12" Padding="12"
                Background="{StaticResource Panel2}" BorderBrush="{StaticResource Edge}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Document" Foreground="{StaticResource TextDim}" Margin="0,2"/>
                <TextBlock x:Name="DocumentText" Grid.Column="1" Margin="0,2"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Text="Mode" Foreground="{StaticResource TextDim}" Margin="0,2"/>
                <TextBlock x:Name="ModeText" Grid.Row="1" Grid.Column="1" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="Captured" Foreground="{StaticResource TextDim}" Margin="0,2"/>
                <TextBlock x:Name="CapturedText" Grid.Row="2" Grid.Column="1" Margin="0,2"/>
                <TextBlock Grid.Row="3" Text="Snapshot" Foreground="{StaticResource TextDim}" Margin="0,2"/>
                <TextBlock x:Name="SizeText" Grid.Row="3" Grid.Column="1" Margin="0,2"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="FreshnessText" Foreground="{StaticResource WarnFg}"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock Text="Recover loads the snapshot into the editor and keeps the original scene path. It remains marked unsaved until you explicitly save."
                       TextWrapping="Wrap"/>
            <TextBlock Text="Discard deletes only recovery data. Cancel keeps it for the next startup and leaves the current document unchanged."
                       Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Recover" Width="96" Height="30" Margin="0,0,8,0"
                    IsDefault="True" Click="OnRecover"/>
            <Button Content="Discard" Width="96" Height="30" Margin="0,0,8,0"
                    Click="OnDiscard"/>
            <Button Content="Cancel" Width="96" Height="30"
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
