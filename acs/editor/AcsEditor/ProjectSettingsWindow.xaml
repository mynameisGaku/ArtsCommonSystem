<Window x:Class="AcsEditor.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Project Settings"
        Height="700" Width="1020" MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Win}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="Overline" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SectionFg}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Compact editor chrome, shared visually with the main workspace. -->
        <Grid DockPanel.Dock="Top"
              Height="34"
              Background="{StaticResource Win}"
              MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                <Border Width="3" Height="18"
                        Background="{StaticResource Accent}"
                        Margin="0,0,8,0"/>
                <TextBlock Text="PROJECT SETTINGS"
                           Foreground="{StaticResource TextDim}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}"
                        Content="&#x2012;"
                        ToolTip="Minimize"
                        Click="OnMinimizeWindow"/>
                <Button Style="{StaticResource CaptionButton}"
                        Content="&#x25A1;"
                        ToolTip="Maximize or restore"
                        Click="OnMaximizeRestoreWindow"/>
                <Button Style="{StaticResource CloseCaptionButton}"
                        Content="&#x2715;"
                        ToolTip="Close"
                        Click="OnCloseWindow"/>
            </StackPanel>
        </Grid>

        <!-- Context and global search. -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}"
                BorderThickness="0,1,0,1"
                Padding="18,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Project configuration"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Runtime, rendering, input, and project-specific values."
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="SEARCH SETTINGS"
                               Style="{StaticResource Overline}"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchBox"
                                     Height="30"
                                     Padding="8,4"
                                     TextChanged="OnSearchChanged"
                                     AutomationProperties.Name="Search project settings"/>
                            <TextBlock x:Name="SearchHint"
                                       Text="Key, description, or category"
                                       Foreground="{StaticResource TextDim}"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <Button x:Name="SearchClearButton"
                                Grid.Column="1"
                                Content="Clear"
                                MinWidth="58"
                                Height="30"
                                Margin="6,0,0,0"
                                Padding="10,3"
                                Visibility="Collapsed"
                                Click="OnClearSearch"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Category navigation. -->
            <Border Grid.RowSpan="2"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Hairline}"
                    BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource HeaderBg}"
                            BorderBrush="{StaticResource Hairline}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CATEGORIES"
                                       Style="{StaticResource Overline}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="CategoryCountText"
                                       Grid.Column="1"
                                       Text="0"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="CatList"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="5"
                             SelectionChanged="OnCatSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               Margin="3,0,8,0"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Count}"
                                               Foreground="{StaticResource TextDim}"
                                               Margin="8,0,4,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Selected category and its editable setting rows. -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Hairline}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderBg}"
                            BorderBrush="{StaticResource Hairline}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SectionTitleText"
                                           Text="All settings"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="ResultSummaryText"
                                           Text="0 settings"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="VisibleCountText"
                                       Grid.Column="1"
                                       Style="{StaticResource Overline}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Rows"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Deliberately separate project-defined keys from built-in settings. -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,10,0,0"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Hairline}"
                    BorderThickness="1"
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CUSTOM SETTING"
                                       Style="{StaticResource Overline}"/>
                            <TextBlock Text="Add a project-owned string value. Custom settings can be removed later."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="Unsaved changes join Save All"
                                   Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Category" Style="{StaticResource FieldCaption}"/>
                            <TextBox x:Name="NewCat"
                                     Height="30"
                                     ToolTip="Existing or new category"
                                     TextChanged="OnCustomFieldChanged"
                                     KeyDown="OnCustomInputKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Key" Style="{StaticResource FieldCaption}"/>
                            <TextBox x:Name="NewKey"
                                     Height="30"
                                     ToolTip="Unique key within this category"
                                     TextChanged="OnCustomFieldChanged"
                                     KeyDown="OnCustomInputKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="Initial value" Style="{StaticResource FieldCaption}"/>
                            <TextBox x:Name="NewValue"
                                     Height="30"
                                     ToolTip="String value"
                                     KeyDown="OnCustomInputKeyDown"/>
                        </StackPanel>
                        <Button x:Name="AddCustomButton"
                                Grid.Column="3"
                                Content="Add setting"
                                MinWidth="104"
                                Height="30"
                                Margin="0,20,0,0"
                                Background="{StaticResource AccentDim}"
                                BorderBrush="{StaticResource Accent}"
                                IsEnabled="False"
                                Click="OnAddCustom"/>
                    </Grid>

                    <TextBlock x:Name="AddValidationText"
                               Grid.Row="2"
                               Foreground="{StaticResource WarnFg}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
