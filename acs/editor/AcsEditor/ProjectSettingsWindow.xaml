<Window x:Class="AcsEditor.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Settings" Height="540" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Win}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontSize="12.5">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- カテゴリ一覧 (UE の左ペイン相当) -->
        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="6" Margin="0,0,8,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="カテゴリ" Margin="10,8,10,4"
                           Foreground="{StaticResource TextDim}"/>
                <ListBox x:Name="CatList" Background="Transparent" BorderThickness="0"
                         Margin="4" SelectionChanged="OnCatSelected"/>
            </DockPanel>
        </Border>

        <!-- 選択カテゴリの設定項目 -->
        <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="6">
            <DockPanel Margin="10">
                <!-- ユーザー定義項目の追加行 -->
                <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="＋ Add" Click="OnAddCustom"
                                Padding="10,4" Margin="6,0,0,0"/>
                        <TextBlock Text="ユーザー定義:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextDim}" Margin="0,0,6,0"/>
                        <TextBox x:Name="NewCat"   Width="120" Margin="0,0,4,0" ToolTip="カテゴリ (新規でも可)"/>
                        <TextBox x:Name="NewKey"   Width="150" Margin="0,0,4,0" ToolTip="キー名"/>
                        <TextBox x:Name="NewValue" ToolTip="値"/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Rows"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
