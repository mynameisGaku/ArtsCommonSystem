<Window x:Class="AcsEditor.AssetReferenceViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Asset Reference Viewer"
        Width="1180" Height="760" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Win}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="11.5"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="ReferenceAmber" Color="#FFE2B65C"/>
        <SolidColorBrush x:Key="ReferenceError" Color="#FFE17272"/>
        <SolidColorBrush x:Key="ReferenceHealthy" Color="#FF78C891"/>

        <Style x:Key="ReferenceCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ReferenceCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ReferenceColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style x:Key="ReferenceCell" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReferenceRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="ToolTip" Value="{Binding Via, StringFormat=Reached through: {0}}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CtrlHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDim}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource ReferenceError}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReferenceGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Panel2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ReferenceColumnHeader}"/>
            <Setter Property="CellStyle" Value="{StaticResource ReferenceCell}"/>
            <Setter Property="RowStyle" Value="{StaticResource ReferenceRow}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Win}"
              MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Border Width="3" Height="18" Background="{StaticResource Accent}" Margin="0,0,8,0"/>
                <TextBlock Text="ASSET REFERENCE VIEWER" Foreground="{StaticResource TextDim}"
                           FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="  /  READ ONLY" Foreground="{StaticResource InfoFg}"
                           FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#x2012;" Click="OnMinimize"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#x25A1;" Click="OnMaximizeRestore"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#x2715;" Click="OnClose"/>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,1"
                Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Content="←" Width="30" Height="28"
                            ToolTip="Previous asset" Click="OnBack"/>
                    <Button x:Name="ForwardButton" Content="→" Width="30" Height="28"
                            Margin="4,0,12,0" ToolTip="Next asset" Click="OnForward"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="RootPathText" FontSize="16" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="RootKindText" Foreground="{StaticResource InfoFg}"
                                   FontWeight="SemiBold" FontSize="10"/>
                        <TextBlock Text="  •  " Foreground="{StaticResource TextDim}"/>
                        <TextBlock x:Name="RootIdText" Foreground="{StaticResource TextDim}"
                                   FontFamily="Consolas" FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DEPTH" Style="{StaticResource ReferenceCaption}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox x:Name="DepthBox" Width="76" Height="28"
                              SelectedIndex="2" SelectionChanged="OnDepthChanged">
                        <ComboBoxItem Content="1" Tag="1"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="8" Tag="8"/>
                        <ComboBoxItem Content="All" Tag="256"/>
                    </ComboBox>
                    <Button Content="Requery" Height="28" Padding="11,2" Margin="8,0,0,0"
                            ToolTip="Requery the in-memory database without modifying assets"
                            Click="OnRequery"/>
                    <Button Content="Copy ID" Height="28" Padding="11,2" Margin="5,0,0,0"
                            Click="OnCopyId"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Border x:Name="DiagnosticsPanel" Grid.Row="0"
                    Style="{StaticResource ReferenceCard}" Margin="0,0,0,10"
                    MaxHeight="132" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource ReferenceAmber}"/>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DiagnosticsItems" Margin="12,7">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{Binding Accent}"
                                                   FontWeight="SemiBold" FontSize="9.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Message}"
                                                   Foreground="{StaticResource Text}"
                                                   FontFamily="{Binding FontFamily}"
                                                   FontSize="10.5" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="214"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ReferenceCard}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource HeaderBg}"
                                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"
                                Padding="11,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="REFERENCERS" Style="{StaticResource ReferenceCaption}"/>
                                    <Border Background="#263F8E62" BorderBrush="#6659B985"
                                            BorderThickness="1" Margin="8,0,0,0" Padding="6,1">
                                        <TextBlock x:Name="ReferencerCountText" Foreground="{StaticResource ReferenceHealthy}"
                                                   FontSize="9.5" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Assets that use the root" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextDim}"
                                           FontSize="10"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="ReferencersGrid" Grid.Row="1"
                                  Style="{StaticResource ReferenceGrid}"
                                  MouseDoubleClick="OnReferenceDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="D" Binding="{Binding Depth}" Width="34"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="72"/>
                                <DataGridTextColumn Header="ASSET PATH" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="ASSET ID" Binding="{Binding AssetId}" Width="190"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <TextBlock Text="REFERENCES" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextDim}" FontSize="9.5"/>
                        <TextBlock Text="←" HorizontalAlignment="Center"
                                   Foreground="{StaticResource ReferenceHealthy}" FontSize="22"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource Panel2}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1"
                            Padding="14,16">
                        <StackPanel>
                            <Border Width="44" Height="44" Background="{StaticResource AccentDim}"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock x:Name="RootGlyphText" Text="ASSET"
                                           Foreground="{StaticResource InfoFg}" FontSize="9"
                                           FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="RootCardPathText" TextAlignment="Center"
                                       TextWrapping="Wrap" FontWeight="SemiBold"
                                       MaxHeight="54"/>
                            <TextBlock x:Name="RootCardKindText" TextAlignment="Center"
                                       Foreground="{StaticResource InfoFg}" FontSize="10"
                                       FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <Border x:Name="HealthBadge" BorderThickness="1" Padding="7,3"
                                    HorizontalAlignment="Center" Margin="0,10,0,0">
                                <TextBlock x:Name="HealthText" FontSize="9.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" VerticalAlignment="Top" Margin="0,12,0,0">
                        <TextBlock Text="→" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Accent}" FontSize="22"/>
                        <TextBlock Text="DEPENDS ON" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextDim}" FontSize="9.5"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Column="2" Style="{StaticResource ReferenceCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource HeaderBg}"
                                BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"
                                Padding="11,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="DEPENDENCIES" Style="{StaticResource ReferenceCaption}"/>
                                    <Border Background="#263C78AA" BorderBrush="#66569CD5"
                                            BorderThickness="1" Margin="8,0,0,0" Padding="6,1">
                                        <TextBlock x:Name="DependencyCountText" Foreground="{StaticResource InfoFg}"
                                                   FontSize="9.5" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Assets required by the root" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{StaticResource TextDim}"
                                           FontSize="10"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="DependenciesGrid" Grid.Row="1"
                                  Style="{StaticResource ReferenceGrid}"
                                  MouseDoubleClick="OnReferenceDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="D" Binding="{Binding Depth}" Width="34"/>
                                <DataGridTextColumn Header="TYPE" Binding="{Binding Kind}" Width="72"/>
                                <DataGridTextColumn Header="ASSET PATH" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="ASSET ID" Binding="{Binding AssetId}" Width="190"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Double-click an existing row to inspect it  •  Esc closes"
                           Foreground="{StaticResource TextDim}" FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
