<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>AcsEditor</AssemblyName>
    <RootNamespace>AcsEditor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- ネイティブ C ABI DLL (CMake が Binaries/Release に出力) を実行フォルダへコピー。
       acs_editor_abi.dll はエンジン静的 lib をリンク済みで自己完結 (DX12/DXGI は OS 提供)。 -->
  <ItemGroup>
    <None Include="..\..\Binaries\Release\acs_editor_abi.dll"
          Condition="Exists('..\..\Binaries\Release\acs_editor_abi.dll')">
      <Link>acs_editor_abi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
