<Window x:Class="AcsEditor.BlueprintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AcsEditor"
        Title="Blueprint" Height="680" Width="1120"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Win}"
        Foreground="{DynamicResource Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" FontSize="12.5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- My Blueprint: BP クラスが持つ変数 (UE5 風) -->
        <DockPanel Grid.Column="0" Background="{DynamicResource Panel}">
            <TextBlock DockPanel.Dock="Top" Text="My Blueprint" Style="{DynamicResource PanelHeader}"/>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Hairline}"/>

            <!-- VARIABLES 見出し + 追加 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBg}" Padding="11,5,7,5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="VARIABLES" Style="{DynamicResource Section}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="＋ 変数" Padding="9,2" FontSize="11" Click="OnAddVar"
                            Foreground="{DynamicResource OkFg}" ToolTip="この BP に変数を追加"/>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Hairline}"/>

            <!-- Details (選択中の変数) を下部に固定 -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Hairline}" BorderThickness="0,1,0,0">
                <StackPanel x:Name="DetailsPanel" Margin="11,9,11,12"/>
            </Border>

            <!-- 変数リスト -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="VarList" Margin="5,4,5,6"/>
            </ScrollViewer>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Edge}"/>

        <local:BlueprintEditor x:Name="GraphHost" Grid.Column="2"/>
    </Grid>
</Window>
