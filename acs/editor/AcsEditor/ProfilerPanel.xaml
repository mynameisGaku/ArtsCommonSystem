<UserControl x:Class="AcsEditor.ProfilerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AcsEditor"
             Background="{StaticResource Panel2}"
             Foreground="{StaticResource Text}"
             Loaded="OnLoaded" Unloaded="OnUnloaded"
             IsVisibleChanged="OnIsVisibleChanged">
    <UserControl.Resources>
        <Style x:Key="ProfilerMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="ProfilerMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ProfilerCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBg}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="PauseButton" Content="Pause"
                                  Padding="9,3" Margin="0,0,5,0"
                                  Checked="OnPauseChanged" Unchecked="OnPauseChanged"/>
                    <Button x:Name="ResetButton" Content="Reset"
                            Padding="9,3" Margin="0,0,10,0"
                            ToolTipService.ShowOnDisabled="True"
                            Click="OnReset"/>
                    <Button x:Name="ExportButton" Content="Export CSV"
                            Padding="9,3" Margin="0,0,10,0"
                            Click="OnExportCsv"
                            ToolTip="Export the current bounded history without stopping capture."/>
                    <CheckBox x:Name="ShowCpuCheck" Content="CPU frame"
                              IsChecked="True" Margin="0,0,9,0"
                              VerticalAlignment="Center" Click="OnDisplayChanged"/>
                    <CheckBox x:Name="ShowGpuCheck" Content="GPU"
                              IsChecked="True" Margin="0,0,9,0"
                              VerticalAlignment="Center" Click="OnDisplayChanged"/>
                    <CheckBox x:Name="ShowPassesCheck" Content="Passes"
                              IsChecked="True" Margin="0,0,9,0"
                              VerticalAlignment="Center" Click="OnDisplayChanged"/>
                    <CheckBox x:Name="ShowCountersCheck" Content="Counters"
                              IsChecked="True" Margin="0,0,9,0"
                              VerticalAlignment="Center" Click="OnDisplayChanged"/>
                    <CheckBox x:Name="ShowCloudCheck" Content="Cloud"
                              IsChecked="True" VerticalAlignment="Center"
                              Click="OnDisplayChanged"/>
                </StackPanel>
                <TextBlock x:Name="AvailabilityText" Grid.Column="1"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextDim}" FontSize="11"
                           Margin="8,0" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="2" Background="{StaticResource Panel2}"
                        BorderBrush="{StaticResource Edge}" BorderThickness="1"
                        Padding="8,3">
                    <TextBlock x:Name="TimingSourceText" Text="CPU record / submit"
                               Foreground="{StaticResource InfoFg}" FontSize="10.5"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TARGET" Foreground="{StaticResource TextDim}"
                           FontSize="10" VerticalAlignment="Center"/>
                <ComboBox x:Name="TargetFpsCombo" Grid.Column="1"
                          Width="78" Margin="7,0,0,0"
                          SelectedIndex="4"
                          SelectionChanged="OnTargetFpsChanged"
                          ToolTip="Frame-rate target used only for analysis; it never changes renderer quality or cadence.">
                    <ComboBoxItem Content="60 FPS" Tag="60"/>
                    <ComboBoxItem Content="120 FPS" Tag="120"/>
                    <ComboBoxItem Content="144 FPS" Tag="144"/>
                    <ComboBoxItem Content="240 FPS" Tag="240"/>
                    <ComboBoxItem Content="300 FPS" Tag="300"/>
                    <ComboBoxItem Content="360 FPS" Tag="360"/>
                </ComboBox>
                <TextBlock Grid.Column="3" Text="BUDGET"
                           Foreground="{StaticResource TextDim}" FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="FrameBudgetValue" Grid.Column="4"
                           Margin="7,0,0,0" Text="3.33 ms"
                           FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="CPU P95"
                           Foreground="{StaticResource TextDim}" FontSize="10"
                           VerticalAlignment="Center"
                           ToolTip="Nearest-rank p95 over recent profiler samples; not every rendered frame."/>
                <TextBlock x:Name="CpuP95Value" Grid.Column="7"
                           Margin="7,0,0,0" Text="N/A"
                           FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="9" Text="GPU P95"
                           Foreground="{StaticResource TextDim}" FontSize="10"
                           VerticalAlignment="Center"
                           ToolTip="Nearest-rank p95 over unique completed GPU timestamp samples; asynchronous latency is reported separately."/>
                <TextBlock x:Name="GpuP95Value" Grid.Column="10"
                           Margin="7,0,0,0" Text="N/A"
                           FontFamily="Consolas" VerticalAlignment="Center"/>
                <TextBlock x:Name="BudgetStateValue" Grid.Column="12"
                           Text="WAITING" Foreground="{StaticResource TextDim}"
                           FontSize="10.5" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="7" Margin="6,5,1,4">
            <Border Style="{StaticResource ProfilerCard}">
                <StackPanel>
                    <TextBlock Text="Editor FPS (avg)" Style="{StaticResource ProfilerMetricLabel}"
                               ToolTip="Observed wall-clock cadence from monotonic sample time and native presented-frame deltas. Includes editor scheduling and presentation stalls."/>
                    <TextBlock x:Name="FpsValue" Text="--" Style="{StaticResource ProfilerMetricValue}"/>
                    <TextBlock x:Name="NativeFpsValue" Text="native --"
                               Foreground="{StaticResource TextDim}" FontFamily="Consolas"
                               FontSize="9.5"
                               ToolTip="Native smoothed interval inside direct render bursts. Diagnostic only; it can exceed the wall-clock editor cadence."/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ProfilerCard}">
                <StackPanel>
                    <TextBlock Text="CPU frame (avg)" Style="{StaticResource ProfilerMetricLabel}"/>
                    <TextBlock x:Name="CpuFrameValue" Text="--" Style="{StaticResource ProfilerMetricValue}"/>
                    <TextBlock x:Name="CpuPeakValue" Text="peak --"
                               Foreground="{StaticResource TextDim}" FontFamily="Consolas"
                               FontSize="9.5"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ProfilerCard}">
                <StackPanel>
                    <TextBlock Text="Submit / Present" Style="{StaticResource ProfilerMetricLabel}"/>
                    <TextBlock x:Name="SubmitValue" Text="--" Style="{StaticResource ProfilerMetricValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ProfilerCard}">
                <StackPanel>
                    <TextBlock Text="GPU frame (avg)" Style="{StaticResource ProfilerMetricLabel}"/>
                    <TextBlock x:Name="GpuFrameValue" Text="N/A" Style="{StaticResource ProfilerMetricValue}"/>
                    <TextBlock x:Name="GpuThroughputValue" Text="throughput N/A"
                               Foreground="{StaticResource TextDim}" FontFamily="Consolas"
                               FontSize="9.5"/>
                    <TextBlock x:Name="GpuPeakValue" Text="peak N/A"
                               Foreground="{StaticResource TextDim}" FontFamily="Consolas"
                               FontSize="9.5"/>
                </StackPanel>
            </Border>
            <Border x:Name="DrawCard" Style="{StaticResource ProfilerCard}">
                <StackPanel>
                    <TextBlock Text="Draw calls" Style="{StaticResource ProfilerMetricLabel}"/>
                    <TextBlock x:Name="DrawCallsValue" Text="--" Style="{StaticResource ProfilerMetricValue}"/>
                </StackPanel>
            </Border>
            <Border x:Name="DispatchCard" Style="{StaticResource ProfilerCard}">
                <StackPanel>
                    <TextBlock Text="Dispatch calls" Style="{StaticResource ProfilerMetricLabel}"/>
                    <TextBlock x:Name="DispatchCallsValue" Text="--" Style="{StaticResource ProfilerMetricValue}"/>
                </StackPanel>
            </Border>
            <Border x:Name="TrianglesCard" Style="{StaticResource ProfilerCard}">
                <StackPanel>
                    <TextBlock Text="Triangles (est.)" Style="{StaticResource ProfilerMetricLabel}"/>
                    <TextBlock x:Name="TrianglesValue" Text="--" Style="{StaticResource ProfilerMetricValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource Edge}" BorderThickness="1">
                <local:ProfilerHistoryGraph x:Name="HistoryGraph"/>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource Edge}"/>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,1,2,0">
                    <Grid x:Name="PassMetrics"
                          ToolTip="CPU RECORD measures command recording inside each named region. GPU AVG / PEAK uses the latest 30 unique valid timestamp-query frames and reports asynchronous latency separately. CPU frame includes all remaining editor and render work. Atmosphere includes sky, IBL and atmosphere/fog-volume construction; Fog is the local-fog composite.">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="116"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="MAJOR PASS" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <TextBlock Grid.Column="1" Text="CPU RECORD" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <TextBlock Grid.Column="2" Text="GPU AVG / PEAK" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <TextBlock Grid.Row="1" Text="Opaque meshes"/>
                        <TextBlock Grid.Row="2" Text="Sky / Atmosphere"/>
                        <TextBlock Grid.Row="3" Text="Cloud"/>
                        <TextBlock Grid.Row="4" Text="Fog composite"/>
                        <TextBlock Grid.Row="5" Text="Post chain"/>
                        <TextBlock Grid.Row="6" Text="Scene mesh cache"/>
                        <TextBlock x:Name="OpaqueCpuValue" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock x:Name="AtmosphereCpuValue" Grid.Row="2" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock x:Name="CloudCpuValue" Grid.Row="3" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock x:Name="FogCpuValue" Grid.Row="4" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock x:Name="PostCpuValue" Grid.Row="5" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock x:Name="OpaqueGpuValue" Grid.Row="1" Grid.Column="2" FontFamily="Consolas"/>
                        <TextBlock x:Name="AtmosphereGpuValue" Grid.Row="2" Grid.Column="2" FontFamily="Consolas"/>
                        <TextBlock x:Name="CloudGpuValue" Grid.Row="3" Grid.Column="2" FontFamily="Consolas"/>
                        <TextBlock x:Name="FogGpuValue" Grid.Row="4" Grid.Column="2" FontFamily="Consolas"/>
                        <TextBlock x:Name="PostGpuValue" Grid.Row="5" Grid.Column="2" FontFamily="Consolas"/>
                        <TextBlock x:Name="MeshCacheStateValue" Grid.Row="6" Grid.Column="1"
                                   Grid.ColumnSpan="2" Text="--" FontFamily="Consolas"
                                   ToolTip="HIT reuses world-space vertices, AABB and the dynamic vertex-buffer upload. REBUILT means geometry, transform, material, visibility or water ownership changed."/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Edge}" Margin="0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CAMERA CULLING"
                                   Foreground="{StaticResource TextDim}" FontSize="10"
                                   ToolTip="One conservative frustum test per eligible authored 3D render node. Downstream depth, motion, opaque and transmission passes reuse the same decision."/>
                        <TextBlock x:Name="CullingStateValue" Grid.Column="1"
                                   Text="DISABLED" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Text="Tested / visible / culled"/>
                        <TextBlock x:Name="CullingCountsValue" Grid.Row="1" Grid.Column="1"
                                   Text="0 / 0 / 0" FontFamily="Consolas"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Edge}" Margin="0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="EDITOR UI / LOG PUMP"
                                   Foreground="{StaticResource TextDim}" FontSize="10"
                                   ToolTip="Native ACS_LOG polling and WPF publication are time-budgeted. Dispatcher stalls are detected by an independent ThreadPool watchdog, so evidence survives a blocked UI thread."/>
                        <TextBlock x:Name="LogPumpStateValue" Grid.Column="1"
                                   Text="IDLE" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="1" Text="Drain last / peak"/>
                        <TextBlock x:Name="LogDrainValue" Grid.Row="1" Grid.Column="1"
                                   Text="0.00 / 0.00 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Text="UI apply last / peak"/>
                        <TextBlock x:Name="LogApplyValue" Grid.Row="2" Grid.Column="1"
                                   Text="0.00 / 0.00 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Text="Console retained / trimmed"/>
                        <TextBlock x:Name="LogRetentionValue" Grid.Row="3" Grid.Column="1"
                                   Text="0 / 0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Text="Native call last / peak"/>
                        <TextBlock x:Name="NativeCallValue" Grid.Row="4" Grid.Column="1"
                                   Text="0.00 / 0.00 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="5" Text="GPU yields / slow calls"
                                   ToolTip="GPU yields are frame-slot backpressure events returned without waiting on the WPF Dispatcher. Slow calls exceeded 50 ms."/>
                        <TextBlock x:Name="NativeBackpressureValue" Grid.Row="5" Grid.Column="1"
                                   Text="0 / 0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="6" Text="GPU retries / fallback"
                                   ToolTip="GPU-busy retries continue through the private HWND pump only inside the bounded epoch. Its deadline requires an Input checkpoint or a due Background drain."/>
                        <TextBlock x:Name="NativeRetryValue" Grid.Row="6" Grid.Column="1"
                                   Text="0 / 0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="7" Text="Ready retry / fairness"
                                   ToolTip="Ready retries completed inside the bounded GPU-busy epoch. Fairness counts mandatory or input-triggered FIFO Input checkpoints plus periodic Background drains."/>
                        <TextBlock x:Name="NativeFairnessValue" Grid.Row="7" Grid.Column="1"
                                   Text="0 / 0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="8" Text="Busy epoch last / peak"/>
                        <TextBlock x:Name="NativeBusyEpochValue" Grid.Row="8" Grid.Column="1"
                                   Text="0.00 / 0.00 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="9" Text="Burst peak frames / active"
                                   ToolTip="Peak Presented frames and render-attempt wall-clock residency between fairness turns. Cooperative GPU-busy retry time is excluded; active time is not OS thread CPU usage."/>
                        <TextBlock x:Name="NativeBurstValue" Grid.Row="9" Grid.Column="1"
                                   Text="0 / 0.00 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="10" Text="Input / maintenance yields"
                                   ToolTip="Input continuations are mandatory burst checkpoints or earlier keyboard/pointer yields. Periodic Background drains own one continuation so startup, timers, and lower-priority work cannot starve."/>
                        <TextBlock x:Name="NativeYieldClassValue" Grid.Row="10" Grid.Column="1"
                                   Text="0 / 0" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="11" Text="Input queue wait last / peak"
                                   ToolTip="Wall-clock delay before a mandatory or keyboard/pointer-triggered Input-priority render checkpoint executes."/>
                        <TextBlock x:Name="NativeContinuationWaitValue" Grid.Row="11" Grid.Column="1"
                                   Text="0.00 / 0.00 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="12" Text="Maintenance wait last / peak"
                                   ToolTip="Wall-clock delay before the periodic Background drain executes. The next native frame waits for this drain, so the value is real render downtime."/>
                        <TextBlock x:Name="NativeMaintenanceWaitValue" Grid.Row="12" Grid.Column="1"
                                   Text="0.00 / 0.00 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="13" Text="Native active / Present"
                                   ToolTip="GPU-ready native renderer CPU residency before submit, followed by submit/Present CPU time. GPU-busy retries and Dispatcher queue wait are excluded."/>
                        <TextBlock x:Name="NativeStageValue" Grid.Row="13" Grid.Column="1"
                                   Text="0.00 / 0.00 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="14" Text="Dispatcher gap last / peak"/>
                        <TextBlock x:Name="DispatcherGapValue" Grid.Row="14" Grid.Column="1"
                                   Text="0.0 / 0.0 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="15" Text="UI stalls / longest"
                                   ToolTip="A stall is declared after two seconds without a Dispatcher heartbeat. ACTIVE means the watchdog currently observes a blocked UI thread."/>
                        <TextBlock x:Name="DispatcherStallValue" Grid.Row="15" Grid.Column="1"
                                   Text="0 / 0.0 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="16" Text="Profiler tick CPU last / peak"
                                   ToolTip="Managed Dispatcher callback cost. The displayed sample includes native snapshot polling and detail publication, but not the two counter TextBlock writes that publish the result."/>
                        <TextBlock x:Name="ProfilerUiValue" Grid.Row="16" Grid.Column="1"
                                   Text="0.00 / 0.00 ms" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="17" Text="Graph OnRender CPU last / peak"
                                   ToolTip="CPU time used to generate WPF drawing commands in OnRender. This is not compositor or GPU presentation time."/>
                        <TextBlock x:Name="ProfilerGraphValue" Grid.Row="17" Grid.Column="1"
                                   Text="0.00 / 0.00 ms" FontFamily="Consolas"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource Edge}" Margin="0,8"/>
                    <Grid x:Name="CloudMetrics">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CLOUD EXACT WORKLOAD" Foreground="{StaticResource TextDim}" FontSize="10"/>
                        <TextBlock x:Name="CloudStateValue" Grid.Column="1"
                                   FontFamily="Consolas" FontSize="10"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Text="Output / trace"/>
                        <TextBlock x:Name="CloudResolutionValue" Grid.Row="1" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="2" Text="Trace dimension scale"/>
                        <TextBlock x:Name="CloudScaleValue" Grid.Row="2" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="3" Text="View / light steps"/>
                        <TextBlock x:Name="CloudStepsValue" Grid.Row="3" Grid.Column="1" FontFamily="Consolas"/>
                        <TextBlock Grid.Row="4" Text="Compute dispatches"
                                   ToolTip="Exact dispatches submitted by the cloud renderer, split into steady trace/resolve, one-time texture bakes, and shadow-cache work. Composite is a draw, not a dispatch."/>
                        <TextBlock x:Name="CloudDispatchValue" Grid.Row="4" Grid.Column="1"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock Grid.Row="5" Text="Total invocations"
                                   ToolTip="Logical invocations exclude workgroup padding. Launched threads include padded workgroup lanes."/>
                        <TextBlock x:Name="CloudTotalInvocationsValue" Grid.Row="5" Grid.Column="1"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock Grid.Row="6" Text="Trace invocations"/>
                        <TextBlock x:Name="CloudTraceInvocationsValue" Grid.Row="6" Grid.Column="1"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock Grid.Row="7" Text="Resolve invocations"/>
                        <TextBlock x:Name="CloudResolveInvocationsValue" Grid.Row="7" Grid.Column="1"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock Grid.Row="8" Text="One-time bake"
                                   ToolTip="Perlin-Worley shape, weather, detail, and curl texture generation. A steady warmed frame should show zero."/>
                        <TextBlock x:Name="CloudBakeValue" Grid.Row="8" Grid.Column="1"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock Grid.Row="9" Text="Shadow-cache work"/>
                        <TextBlock x:Name="CloudShadowInvocationsValue" Grid.Row="9" Grid.Column="1"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock Grid.Row="10" Text="Temporal history"/>
                        <TextBlock x:Name="CloudHistoryValue" Grid.Row="10" Grid.Column="1"
                                   FontFamily="Consolas" FontSize="10"/>
                        <TextBlock Grid.Row="11" Text="Sample ceilings"
                                   ToolTip="Conservative shader-loop ceilings, not measured samples. Empty-space skipping and transmittance exits reduce actual work; GPU timestamps remain authoritative for elapsed cost."/>
                        <TextBlock x:Name="CloudSampleCeilingsValue" Grid.Row="11" Grid.Column="1"
                                   FontFamily="Consolas" FontSize="10"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
