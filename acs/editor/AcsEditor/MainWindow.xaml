<Window x:Class="AcsEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AcsEditor"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ACS Editor" Height="900" Width="1480" MinHeight="680" MinWidth="1080"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Win}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <!-- PanelHeader / Section / FieldLabel / NumBox は Themes/Dark.xaml に共通定義 (全ウィンドウ共有) -->
        <Style x:Key="SectionHeader" TargetType="Grid">
            <Setter Property="Margin" Value="0,15,0,7"/>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="OnUndo" CanExecute="OnCanUndo"/>
        <CommandBinding Command="ApplicationCommands.Redo" Executed="OnRedo" CanExecute="OnCanRedo"/>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopyDelete"/>
        <CommandBinding Command="ApplicationCommands.Paste" Executed="OnPaste" CanExecute="OnCanPaste"/>
        <CommandBinding Command="ApplicationCommands.Delete" Executed="OnDeleteCmd" CanExecute="OnCanCopyDelete"/>
        <CommandBinding Command="ApplicationCommands.SelectAll" Executed="OnSelectAll"/>
    </Window.CommandBindings>

    <DockPanel>
        <!-- カスタムタイトルバー (OS chrome を置き換え、ダークテーマに統一) -->
        <Grid DockPanel.Dock="Top" Background="{StaticResource Win}" Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Border Width="3" Height="18" Background="{StaticResource Accent}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource TextDim}" FontSize="11.5" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 中央は空 = ドラッグ領域 (WindowChrome CaptionHeight が拾う) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#x2012;" Click="OnMinimizeWin"/>
                <Button x:Name="MaxRestoreBtn" Style="{StaticResource CaptionButton}" Content="&#x25A1;" Click="OnMaximizeRestoreWin"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#x2715;" Click="OnCloseWin"/>
            </StackPanel>
        </Grid>

        <!-- メニュー -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem x:Name="FileNewSceneMenu" Header="New Scene" Click="OnNewScene" InputGestureText="Ctrl+N"/>
                <MenuItem x:Name="FileOpenSceneMenu" Header="Open Scene…" Click="OnOpenScene"/>
                <MenuItem x:Name="FileSaveSceneMenu" Header="Save Scene…" Click="OnSaveScene" InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="FileSaveAllScenesMenu" Header="Save All" Click="OnSaveAllScenes" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="Exit" Click="OnExit"/>
            </MenuItem>
            <MenuItem x:Name="SceneEditMenu" Header="_Edit">
                <MenuItem Header="Undo" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="Redo" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y"/>
                <MenuItem Header="Command Palette…" Click="OnCommandPalette" InputGestureText="Ctrl+Shift+P"/>
                <Separator/>
                <MenuItem Header="Cut" Click="OnCut" InputGestureText="Ctrl+X"/>
                <MenuItem Header="Copy"  Command="ApplicationCommands.Copy"  InputGestureText="Ctrl+C"/>
                <MenuItem Header="Paste" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
                <MenuItem Header="Duplicate" Click="OnDuplicateNode" InputGestureText="Ctrl+D"/>
                <MenuItem Header="Delete" Command="ApplicationCommands.Delete" InputGestureText="Del"/>
                <Separator/>
                <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A"/>
                <Separator/>
                <MenuItem Header="Project Settings…" Click="OnProjectSettings"/>
            </MenuItem>
            <MenuItem x:Name="GameObjectMenu" Header="_GameObject">
                <MenuItem Header="Create Empty" Click="OnCreateEmpty"/>
                <MenuItem Header="Create Child of Selection" Click="OnCreateChild"/>
                <Separator/>
                <MenuItem Header="3D Cube"   Click="OnAdd3DCube"/>
                <MenuItem Header="3D Sphere" Click="OnAdd3DSphere"/>
                <MenuItem Header="3D Plane"  Click="OnAdd3DPlane"/>
                <MenuItem Header="2D Polygon (z=0)" Click="OnAdd2DPolygon"/>
                <MenuItem Header="Sprite… (z=0 画像)" Click="OnAddSprite"/>
                <MenuItem Header="3D Mesh… (.gltf/.obj)" Click="OnImport3DMesh"/>
            </MenuItem>
            <MenuItem Header="_Build">
                <MenuItem Header="新規クラス…" Click="OnNewClass"/>
                <Separator/>
                <MenuItem x:Name="MenuBuild"     Header="Build"        Click="OnBuildProject"  InputGestureText="F7"/>
                <MenuItem x:Name="MenuRun"       Header="Run"          Click="OnRunProject"    InputGestureText="Ctrl+F5"/>
                <MenuItem x:Name="MenuBuildRun"  Header="Build &amp; Run" Click="OnBuildAndRun" InputGestureText="F5"/>
                <Separator/>
                <MenuItem x:Name="MenuPackage" Header="Package Project…" Click="OnPackageProject"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Anti-aliasing">
                    <MenuItem x:Name="AaFxaa"  Header="FXAA"    IsCheckable="True" Tag="1" Click="OnAaMenuClick"/>
                    <MenuItem x:Name="AaMsaa2" Header="MSAA 2x" IsCheckable="True" Tag="2" Click="OnAaMenuClick"/>
                    <MenuItem x:Name="AaMsaa4" Header="MSAA 4x" IsCheckable="True" Tag="4" Click="OnAaMenuClick"/>
                    <MenuItem x:Name="AaMsaa8" Header="MSAA 8x" IsCheckable="True" Tag="8" IsChecked="True" Click="OnAaMenuClick"/>
                </MenuItem>
                <MenuItem Header="Graphics Quality">
                    <MenuItem x:Name="QualUltra"   Header="Ultra (4K 影・CSM 4 カスケード)" IsCheckable="True" Tag="Ultra"   Click="OnQualityMenuClick"/>
                    <MenuItem x:Name="QualHighest" Header="Highest (4K 影・CSM 3 カスケード)" IsCheckable="True" Tag="Highest" Click="OnQualityMenuClick"/>
                    <MenuItem x:Name="QualHigh"    Header="High (2K 影・既定)"              IsCheckable="True" Tag="High" IsChecked="True" Click="OnQualityMenuClick"/>
                    <MenuItem x:Name="QualMedium"  Header="Medium (2K 影)"                  IsCheckable="True" Tag="Medium"  Click="OnQualityMenuClick"/>
                    <MenuItem x:Name="QualLow"     Header="Low (1K 影)"                     IsCheckable="True" Tag="Low"     Click="OnQualityMenuClick"/>
                    <MenuItem x:Name="QualLowest"  Header="Lowest (影オフ)"                 IsCheckable="True" Tag="Lowest"  Click="OnQualityMenuClick"/>
                </MenuItem>
                <MenuItem Header="Lighting (時間帯)">
                    <MenuItem Header="Noon (正午・既定)" Tag="Noon" Click="OnLightingPreset"/>
                    <MenuItem Header="Sunset (夕焼け)" Tag="Sunset" Click="OnLightingPreset"/>
                    <MenuItem Header="Overcast (曇天)" Tag="Overcast" Click="OnLightingPreset"/>
                    <MenuItem Header="Night (夜)" Tag="Night" Click="OnLightingPreset"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="ShowGridItem" Header="Show Grid (グリッド表示)" IsCheckable="True" IsChecked="True" Click="OnToggleGrid"/>
                <MenuItem Header="Panels">
                    <MenuItem x:Name="MenuShowHierarchy" Header="Hierarchy" Tag="hierarchy"
                              IsCheckable="True" IsChecked="True" Click="OnTogglePanelVisibility"/>
                    <MenuItem x:Name="MenuShowInspector" Header="Inspector" Tag="inspector"
                              IsCheckable="True" IsChecked="True" Click="OnTogglePanelVisibility"/>
                    <MenuItem x:Name="MenuShowBottom" Header="Console / Assets" Tag="bottom"
                              IsCheckable="True" IsChecked="True" InputGestureText="Ctrl+J"
                              Click="OnTogglePanelVisibility"/>
                    <MenuItem x:Name="MenuShowProfiler" Header="Profiler" IsCheckable="True"
                              Click="OnShowProfiler" ToolTip="Open the renderer profiler in the bottom dock"/>
                    <Separator/>
                    <MenuItem Header="Reset Layout" Click="OnResetEditorLayout"/>
                </MenuItem>
                <MenuItem x:Name="WorkspaceMenu" Header="Workspaces"
                          SubmenuOpened="OnWorkspaceMenuOpened"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About ACS Editor" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- Project actions, simulation transport, and build actions are separate visual groups. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <Grid Margin="8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="SceneDocumentActions" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="New" Click="OnNewScene" Style="{StaticResource ToolbarButton}" ToolTip="New Scene (Ctrl+N)"/>
                    <Button Content="Open" Click="OnOpenScene" Style="{StaticResource ToolbarButton}" ToolTip="Open Scene"/>
                    <Button x:Name="SaveBtn" Content="Save" Click="OnSaveScene" Style="{StaticResource ToolbarButton}" ToolTip="Save Scene (Ctrl+S)"/>
                    <Separator/>
                    <TextBlock x:Name="SceneNameText" Text="Untitled" Style="{StaticResource StateLabel}"
                               MaxWidth="190" TextTrimming="CharacterEllipsis" Margin="3,0,7,0"/>
                    <TextBlock x:Name="SaveStateText" Text="SAVED" Style="{StaticResource StateLabel}"/>
                </StackPanel>
                <StackPanel x:Name="ScenePlaybackActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PlayBtn" Content="Play" Click="OnPlay" Style="{StaticResource PlayToolbarButton}"
                            ToolTip="Play / Stop"/>
                    <Button x:Name="PauseBtn" Content="Pause" Click="OnPause" Style="{StaticResource ToolbarButton}"
                            IsEnabled="False" ToolTip="Pause / Resume"/>
                    <Button x:Name="StepBtn" Content="Step" Click="OnStep" Style="{StaticResource ToolbarButton}"
                            IsEnabled="False" ToolTip="Advance one frame while paused"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ToggleButton x:Name="PreviewBtn" Content="Preview" Click="OnTogglePreview" Style="{StaticResource ToolbarToggle}"/>
                    <Button x:Name="BpRunBtn" Content="Blueprints" Click="OnRunBlueprints" Style="{StaticResource ToolbarButton}"/>
                    <Separator/>
                    <Button x:Name="BuildBtn" Content="Build" Click="OnBuildProject" Style="{StaticResource ToolbarButton}"
                            ToolTip="Build (F7)"/>
                    <Button x:Name="RunBtn" Content="Build + Run" Click="OnBuildAndRun" Style="{StaticResource ToolbarButton}"
                            Foreground="{StaticResource InfoFg}" ToolTip="Build and Run (F5)"/>
                    <ToggleButton x:Name="HotReloadBtn" Content="Hot Reload" Click="OnHotReloadToggle" Style="{StaticResource ToolbarToggle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Height="24" Background="{StaticResource Panel}" BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
            <Grid Margin="9,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource StateLabel}" Text="Ready"/>
                <TextBlock x:Name="SceneModeText" Grid.Column="1" Style="{StaticResource StateLabel}"
                           Text="VIEW: 2D" Margin="0,0,18,0"/>
                <TextBlock x:Name="PlayStatusText" Grid.Column="2" Style="{StaticResource StateLabel}"
                           Text="EDIT" Margin="0,0,18,0"/>
                <TextBlock x:Name="WorkspaceStateText" Grid.Column="3" Style="{StaticResource StateLabel}"
                           Text="WORKSPACE: LEVEL EDITING" Margin="0,0,18,0"/>
                <TextBlock x:Name="ProfilerStatusText" Grid.Column="4" Style="{StaticResource StateLabel}"
                           Text="-- FPS | Frame -- ms | CPU record/submit" Margin="0,0,18,0"
                           ToolTip="Renderer profiler summary. View → Panels → Profiler opens the history."/>
                <TextBlock x:Name="ViewportInfo" Grid.Column="5" Style="{StaticResource StateLabel}" Text=""/>
            </Grid>
        </Border>

        <!-- 本体: Hierarchy | (Viewport / Console) | Inspector -->
        <Grid x:Name="SceneWorkspace" Background="{StaticResource Edge}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HierarchyColumn" Width="260"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="348"/>
            </Grid.ColumnDefinitions>

            <!-- 左カラム: Scene Outliner -->
            <DockPanel x:Name="HierarchyPanel" Grid.Column="0" Background="{StaticResource Panel}">
                <Grid DockPanel.Dock="Top" Background="{StaticResource HeaderBg}">
                    <TextBlock Text="SCENE OUTLINER" Style="{StaticResource PanelHeader}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,4,2">
                        <TextBlock x:Name="HierarchyCountText" Text="0" Style="{StaticResource StateLabel}" Margin="0,0,5,0"/>
                        <Button Content="+ ADD" Click="OnCreateEmpty" Style="{StaticResource PanelToolButton}"
                                MinWidth="50" ToolTip="Add an empty actor to the current scene"/>
                    </StackPanel>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Hairline}"/>
                <Grid DockPanel.Dock="Top" Margin="6,6,4,2">
                    <TextBox x:Name="HierSearchBox" Height="25" Padding="7,2,24,2"
                             VerticalContentAlignment="Center" ToolTip="Filter hierarchy by object name"
                             TextChanged="OnHierSearchChanged"/>
                    <Button Content="×" HorizontalAlignment="Right" Width="23" Height="23" Margin="0,1,1,1"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            Foreground="{StaticResource TextDim}" Click="OnClearHierarchySearch"
                            ToolTip="Clear hierarchy filter"/>
                </Grid>
                <TreeView x:Name="HierarchyTree" Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                          BorderThickness="0" Margin="5,3,3,4"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="OnHierarchySelect">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="空のオブジェクト" Click="OnCtxCreateEmpty"/>
                            <MenuItem x:Name="CtxBuiltin" Header="ビルトインのオブジェクト"/>
                            <MenuItem x:Name="CtxUser" Header="ユーザー定義のオブジェクト"/>
                            <Separator/>
                            <MenuItem Header="Blueprint として保存…" Click="OnCtxSaveBlueprint"/>
                            <MenuItem Header="名前を変更" Click="OnCtxRename"/>
                            <MenuItem Header="複製" Click="OnDuplicateNode" InputGestureText="Ctrl+D"/>
                            <MenuItem Header="削除" Click="OnCtxDelete" InputGestureText="Del"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>

            <GridSplitter x:Name="HierarchySplitter" Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch" Background="{StaticResource Edge}"
                          DragCompleted="OnWorkspaceSplitterDragCompleted"/>

            <!-- 中央: Viewport (上) + Console (下) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition x:Name="BottomDockRow" Height="210"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Background="{StaticResource Edge}">
                    <Grid DockPanel.Dock="Top" Background="{StaticResource Panel2}" Height="33">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ToggleButton x:Name="SceneTabBtn" Content="Scene" IsChecked="True" Click="OnSceneTab"
                                          Style="{StaticResource ViewportTab}"/>
                            <ToggleButton x:Name="GameTabBtn" Content="Game" Click="OnGameTab"
                                          Style="{StaticResource ViewportTab}"/>
                            <ToggleButton x:Name="BlueprintTabBtn" Content="Blueprint" Click="OnBlueprintTab"
                                          Style="{StaticResource ViewportTab}"/>
                        </StackPanel>
                        <!-- Scene-local tools: projection, transform mode, snapping, and camera framing. -->
                        <StackPanel x:Name="SceneTools" Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                            <ToggleButton x:Name="PerspectiveViewBtn" Content="Perspective"
                                          Click="OnSceneViewPerspective"
                                          Style="{StaticResource ToolbarToggle}"
                                          ToolTip="Perspective view of the current scene"/>
                            <ToggleButton x:Name="Scene2DViewBtn" Content="2D (Orthographic)"
                                          Click="OnSceneView2D"
                                          Style="{StaticResource ToolbarToggle}"
                                          ToolTip="XY-front orthographic view with orbit disabled and pan navigation"/>
                            <Separator/>
                            <ToggleButton x:Name="PolyBtn" Content="Polygon" Click="OnPolyToggle"
                                          Style="{StaticResource ToolbarToggle}"/>
                            <Separator/>
                            <ToggleButton x:Name="GizMove" Content="Move  W" Click="OnGizmoMove"
                                          Style="{StaticResource ToolbarToggle}" ToolTip="Move (W)"/>
                            <ToggleButton x:Name="GizRotate" Content="Rotate  E" Click="OnGizmoRotate"
                                          Style="{StaticResource ToolbarToggle}" ToolTip="Rotate (E)"/>
                            <ToggleButton x:Name="GizScale" Content="Scale  R" Click="OnGizmoScale"
                                          Style="{StaticResource ToolbarToggle}" ToolTip="Scale (R)"/>
                            <CheckBox x:Name="SnapCheck" Content="Snap" Click="OnSnapToggle"
                                      VerticalAlignment="Center" Margin="7,0,5,0"/>
                            <ComboBox x:Name="SnapPresetBox" Width="76" Height="25" SelectedIndex="1"
                                      SelectionChanged="OnSnapPresetChanged" ToolTip="Transform snap increments">
                                <ComboBoxItem Content="Fine"/>
                                <ComboBoxItem Content="Default"/>
                                <ComboBoxItem Content="Coarse"/>
                            </ComboBox>
                            <Separator/>
                            <Button Content="Focus  F" Click="OnFocus" Style="{StaticResource ToolbarButton}"/>
                            <Button Content="Frame All" Click="OnResetView" Style="{StaticResource ToolbarButton}"/>
                            <Menu Background="Transparent" VerticalAlignment="Center" Padding="0">
                                <MenuItem Header="Align" Padding="7,3" ToolTip="Align and distribute selected objects">
                                    <MenuItem Header="Align Left" Click="OnAlignLeft"/>
                                    <MenuItem Header="Align Right" Click="OnAlignRight"/>
                                    <MenuItem Header="Align Top" Click="OnAlignTop"/>
                                    <MenuItem Header="Align Bottom" Click="OnAlignBottom"/>
                                    <MenuItem Header="Center Horizontally" Click="OnAlignHC"/>
                                    <MenuItem Header="Center Vertically" Click="OnAlignVC"/>
                                    <Separator/>
                                    <MenuItem Header="Distribute Horizontally" Click="OnDistributeH"/>
                                    <MenuItem Header="Distribute Vertically" Click="OnDistributeV"/>
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Border x:Name="ViewportHost" Background="{StaticResource Edge}" Margin="0"/>
                        <Border x:Name="ViewportLoadingOverlay"
                                Panel.ZIndex="10"
                                Background="#FF09111B"
                                IsHitTestVisible="True">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="460">
                                <TextBlock x:Name="ViewportLoadingTitle"
                                           Text="Loading scene…"
                                           Foreground="#FFF0F4F8"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ViewportLoadingDetail"
                                           Text="Preparing the renderer"
                                           Foreground="#FF8FA6BB"
                                           Margin="0,7,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <GridSplitter x:Name="BottomDockSplitter" Grid.Row="1" Height="4"
                              HorizontalAlignment="Stretch" Background="{StaticResource Edge}"
                              DragCompleted="OnWorkspaceSplitterDragCompleted"/>

                <Grid x:Name="BottomDockPanel" Grid.Row="2" Background="{StaticResource Panel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 下部パネルのタブ見出し + ログのフィルタ/検索/ソート -->
                    <DockPanel Grid.Row="0" Background="{StaticResource HeaderBg}">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <ToggleButton x:Name="TabConsole" Content="Console" IsChecked="True"
                                          Style="{StaticResource ViewportTab}" Click="OnBottomTab" Tag="console"/>
                            <ToggleButton x:Name="TabBuild" Content="Build"
                                          Style="{StaticResource ViewportTab}" Click="OnBottomTab" Tag="build"/>
                            <ToggleButton x:Name="TabAssets" Content="Assets"
                                          Style="{StaticResource ViewportTab}" Click="OnBottomTab" Tag="assets"/>
                            <ToggleButton x:Name="TabProfiler" Content="Profiler"
                                          Style="{StaticResource ViewportTab}" Click="OnBottomTab" Tag="profiler"/>
                        </StackPanel>
                        <!-- 右: ログツールバー (Console タブのときだけ表示) -->
                        <StackPanel x:Name="LogToolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBox x:Name="LogSearch" Width="150" Height="22" Padding="6,2" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" TextChanged="OnLogFilterChanged"
                                     ToolTip="ログを文字列で絞り込み"/>
                            <ToggleButton x:Name="FltInfo"  Content="Info"  IsChecked="True" Padding="7,3" Margin="1,0" Click="OnLogFilterChanged" Tag="info"/>
                            <ToggleButton x:Name="FltWarn"  Content="Warnings" IsChecked="True" Padding="7,3" Margin="1,0" Click="OnLogFilterChanged" Tag="warn"/>
                            <ToggleButton x:Name="FltError" Content="Errors" IsChecked="True" Padding="7,3" Margin="1,0" Click="OnLogFilterChanged" Tag="error"/>
                            <ToggleButton x:Name="SortNewest" Content="Newest last" Padding="7,3" Margin="6,0,0,0" Click="OnLogSortToggle"
                                          ToolTip="新しい順 / 古い順を切替"/>
                            <Button Content="Clear" Padding="8,3" Margin="6,0,0,0" Click="OnClearLog"/>
                            <Button x:Name="BottomDockToggleBtn" Content="Hide" Style="{StaticResource PanelToolButton}"
                                    Margin="6,0,0,0" Click="OnToggleBottomDock" ToolTip="Hide bottom panel (Ctrl+J)"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="ConsoleList" Grid.Row="1" Background="{StaticResource Panel2}"
                             BorderThickness="0" FontSize="12" Margin="4"
                             SelectionMode="Extended" KeyDown="OnConsoleKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="コピー (選択行)" Click="OnCopyLog" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="すべてコピー"   Click="OnCopyAllLog"/>
                                <Separator/>
                                <MenuItem Header="クリア"         Click="OnClearLog"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextDim}" FontFamily="Consolas" Width="62" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource LogChip}" Background="{Binding ChipBrush}">
                                        <TextBlock Text="{Binding Tag}" Foreground="{Binding ChipFg}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding MsgBrush}" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="BuildList" Grid.Row="1" Background="{StaticResource Panel2}" Foreground="#FFB7BEC8"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12" Margin="4" Visibility="Collapsed"
                             SelectionMode="Extended" KeyDown="OnBuildKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="コピー (選択行)" Click="OnCopyBuild" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="すべてコピー"   Click="OnCopyAllBuild"/>
                                <Separator/>
                                <MenuItem Header="クリア"         Click="OnClearBuild"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontFamily="Consolas"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <local:AssetBrowserPanel x:Name="AssetBrowser" Grid.Row="1" Visibility="Collapsed"/>
                    <local:ProfilerPanel x:Name="ProfilerView" Grid.Row="1" Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="4"
                          HorizontalAlignment="Stretch" Background="{StaticResource Edge}"
                          DragCompleted="OnWorkspaceSplitterDragCompleted"/>

            <!-- UE-style Details panel -->
            <DockPanel x:Name="InspectorPanel" Grid.Column="4" Background="{StaticResource Panel}">
                <Grid DockPanel.Dock="Top" Background="{StaticResource HeaderBg}">
                    <TextBlock Text="DETAILS" Style="{StaticResource PanelHeader}"/>
                    <TextBlock Text="Selection" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,10,0" Style="{StaticResource StateLabel}"/>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Hairline}"/>
                <Grid DockPanel.Dock="Top" Margin="7,7,7,6">
                    <TextBox x:Name="DetailsSearchBox" Height="26" Padding="8,2,26,2"
                             VerticalContentAlignment="Center"
                             ToolTip="Search properties and components"
                             TextChanged="OnDetailsSearchChanged"/>
                    <TextBlock x:Name="DetailsSearchHint" Text="Search Details" Margin="9,0,28,0"
                               VerticalAlignment="Center" Foreground="{StaticResource TextDim}"
                               FontSize="11" IsHitTestVisible="False"/>
                    <Button Content="×" HorizontalAlignment="Right" Width="24" Height="24" Margin="0,1,1,1"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            Foreground="{StaticResource TextDim}" Click="OnClearDetailsSearch"
                            ToolTip="Clear Details filter"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <StackPanel Margin="8,0,8,10">
                        <!-- 選択ノードのヘッダ -->
                        <Border Background="{StaticResource Panel2}" CornerRadius="0" Padding="10,8" Margin="0,0,0,4">
                            <StackPanel>
                                <!-- オブジェクト名 + 有効(Enabled) トグル (名前の横)。3D ノード選択時のみ表示。 -->
                                <DockPanel LastChildFill="True">
                                    <CheckBox x:Name="InspEnabled" DockPanel.Dock="Right" Content="Enabled" Visibility="Collapsed"
                                              VerticalAlignment="Center" Foreground="{StaticResource Text}" Margin="8,0,0,0"
                                              Checked="OnInspEnabledChanged" Unchecked="OnInspEnabledChanged" ToolTip="有効 (Enabled)"/>
                                    <TextBlock x:Name="InspName" Text="(no selection)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="InspSub" Text="ノードを選択してください" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 3D ノードの Inspector (3D モードで動的生成。2D の InspFields は隠す)。 -->
                        <StackPanel x:Name="Insp3DPanel" Visibility="Collapsed"/>

                        <StackPanel x:Name="InspFields" IsEnabled="False">
                            <Grid Style="{StaticResource SectionHeader}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="TRANSFORM" Style="{StaticResource Section}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource NumBox}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Position" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PosX" Grid.Column="1" Style="{StaticResource NumBox}" Margin="0,0,3,0"/>
                                <TextBox x:Name="PosY" Grid.Column="2" Style="{StaticResource NumBox}" Margin="3,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Rotation°" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RotDeg" Grid.Column="1" Style="{StaticResource NumBox}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Scale" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ScaleX" Grid.Column="1" Style="{StaticResource NumBox}" Margin="0,0,3,0"/>
                                <TextBox x:Name="ScaleY" Grid.Column="2" Style="{StaticResource NumBox}" Margin="3,0,0,0"/>
                            </Grid>

                            <Grid Style="{StaticResource SectionHeader}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="DISPLAY" Style="{StaticResource Section}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <CheckBox x:Name="DispVisible" Content="Visible" Margin="0,0,18,0" Click="OnDispVisible"/>
                                <CheckBox x:Name="DispEnabled" Content="Enabled" Click="OnDispEnabled"/>
                            </StackPanel>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Sort Layer" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DispLayer" Grid.Column="1" Style="{StaticResource NumBox}" Margin="0,0,8,0"/>
                                <TextBlock Text="Base" Grid.Column="2" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DispBase" Grid.Column="3" Style="{StaticResource NumBox}"/>
                            </Grid>
                            <!-- RGBA は固定幅でなく可変 (*) 列にし、狭いインスペクタでも縮んでスウォッチ(末尾 Auto 列)が
                                 右端で見切れないようにする (旧: 固定 40px×4 で * 列が縮まず swatch が押し出されていた)。 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                                <Grid Grid.Column="1" Margin="0,0,6,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="ColR" Grid.Column="0" Margin="0,0,3,0" Style="{StaticResource NumBox}"/>
                                    <TextBox x:Name="ColG" Grid.Column="1" Margin="0,0,3,0" Style="{StaticResource NumBox}"/>
                                    <TextBox x:Name="ColB" Grid.Column="2" Margin="0,0,3,0" Style="{StaticResource NumBox}"/>
                                    <TextBox x:Name="ColA" Grid.Column="3" Style="{StaticResource NumBox}"/>
                                </Grid>
                                <Border x:Name="ColorSwatch" Grid.Column="2" Width="26" Height="26" CornerRadius="0"
                                        Background="#FF888888" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                                        Cursor="Hand" ToolTip="Open RGBA color picker"
                                        MouseLeftButtonDown="OnDisplayColorSwatchClicked"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Sprite" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="SpriteLabel" Grid.Column="1" Text="(なし)" Foreground="{StaticResource TextDim}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="…" Click="OnBrowseSprite" Padding="9,2" Margin="0,0,4,0"/>
                                    <Button Content="Clear" Click="OnClearSprite" Padding="7,2" Foreground="{StaticResource WarnFg}"/>
                                </StackPanel>
                            </Grid>

                            <!-- マテリアル (効果プリセット)。ノードは選ぶだけ。効果の編集はマテリアルエディタで。 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Material" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="MaterialBox" Grid.Column="1" SelectionChanged="OnMaterialSelected" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Edit" Click="OnEditMaterial" Padding="7,2" Margin="0,0,4,0" ToolTip="Edit material" Foreground="{StaticResource InfoFg}"/>
                                    <Button Content="New" Click="OnNewMaterial" Padding="7,2" Margin="0,0,4,0" ToolTip="Create material" Foreground="{StaticResource OkFg}"/>
                                    <Button Content="Clear" Click="OnClearMaterial" Padding="7,2" ToolTip="Remove material" Foreground="{StaticResource WarnFg}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SectionHeader}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="COMPONENTS" Style="{StaticResource Section}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel x:Name="CompList"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CompAddBox" Grid.Column="0"/>
                                <Button Grid.Column="1" Content="+ Add" Click="OnAddComponent" Margin="6,0,0,0" Padding="10,4" Foreground="{StaticResource OkFg}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="MultiHint" Visibility="Collapsed" Foreground="{StaticResource TextDim}"
                                   Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Text="複数選択中: transform 編集は単一選択時のみ。Duplicate / Delete は選択全体に効きます。"/>

                        <StackPanel x:Name="ActionButtons" Orientation="Horizontal" Margin="0,14,0,0" IsEnabled="False">
                            <Button Content="Duplicate" Click="OnDuplicateNode" Padding="10,5" Margin="0,0,6,0" Foreground="{StaticResource LinkFg}"/>
                            <Button x:Name="DeleteBtn" Content="Delete" Click="OnDeleteNode" Padding="10,5" Foreground="{StaticResource WarnFg}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
