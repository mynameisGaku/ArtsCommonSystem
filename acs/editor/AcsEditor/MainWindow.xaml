<Window x:Class="AcsEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AcsEditor"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ACS Editor" Height="760" Width="1240"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Win}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontSize="12.5">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <!-- PanelHeader / Section / FieldLabel / NumBox は Themes/Dark.xaml に共通定義 (全ウィンドウ共有) -->
        <Style x:Key="SectionHeader" TargetType="Grid">
            <Setter Property="Margin" Value="0,15,0,7"/>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="OnUndo" CanExecute="OnCanUndo"/>
        <CommandBinding Command="ApplicationCommands.Redo" Executed="OnRedo" CanExecute="OnCanRedo"/>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopyDelete"/>
        <CommandBinding Command="ApplicationCommands.Paste" Executed="OnPaste" CanExecute="OnCanPaste"/>
        <CommandBinding Command="ApplicationCommands.Delete" Executed="OnDeleteCmd" CanExecute="OnCanCopyDelete"/>
        <CommandBinding Command="ApplicationCommands.SelectAll" Executed="OnSelectAll"/>
    </Window.CommandBindings>

    <DockPanel>
        <!-- カスタムタイトルバー (OS chrome を置き換え、ダークテーマに統一) -->
        <Grid DockPanel.Dock="Top" Background="{StaticResource Edge}" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 中央は空 = ドラッグ領域 (WindowChrome CaptionHeight が拾う) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#x2012;" Click="OnMinimizeWin"/>
                <Button x:Name="MaxRestoreBtn" Style="{StaticResource CaptionButton}" Content="&#x25A1;" Click="OnMaximizeRestoreWin"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#x2715;" Click="OnCloseWin"/>
            </StackPanel>
        </Grid>

        <!-- メニュー -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="New Scene" Click="OnNewScene" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Open Scene…" Click="OnOpenScene"/>
                <MenuItem Header="Save Scene…" Click="OnSaveScene" InputGestureText="Ctrl+S"/>
                <Separator/>
                <MenuItem Header="Exit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="Redo" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Cut" Click="OnCut" InputGestureText="Ctrl+X"/>
                <MenuItem Header="Copy"  Command="ApplicationCommands.Copy"  InputGestureText="Ctrl+C"/>
                <MenuItem Header="Paste" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V"/>
                <MenuItem Header="Duplicate" Click="OnDuplicateNode" InputGestureText="Ctrl+D"/>
                <MenuItem Header="Delete" Command="ApplicationCommands.Delete" InputGestureText="Del"/>
                <Separator/>
                <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A"/>
                <Separator/>
                <MenuItem Header="Project Settings…" Click="OnProjectSettings"/>
            </MenuItem>
            <MenuItem Header="_GameObject">
                <MenuItem Header="Create Empty" Click="OnCreateEmpty"/>
                <MenuItem Header="Create Child of Selection" Click="OnCreateChild"/>
                <Separator/>
                <MenuItem Header="3D Cube"   Click="OnAdd3DCube"/>
                <MenuItem Header="3D Sphere" Click="OnAdd3DSphere"/>
                <MenuItem Header="3D Plane"  Click="OnAdd3DPlane"/>
                <MenuItem Header="2D Polygon (z=0)" Click="OnAdd2DPolygon"/>
                <MenuItem Header="Sprite… (z=0 画像)" Click="OnAddSprite"/>
                <MenuItem Header="3D Mesh… (.gltf/.obj)" Click="OnImport3DMesh"/>
            </MenuItem>
            <MenuItem Header="_Build">
                <MenuItem Header="新規クラス…" Click="OnNewClass"/>
                <Separator/>
                <MenuItem x:Name="MenuBuild"     Header="Build"        Click="OnBuildProject"  InputGestureText="F7"/>
                <MenuItem x:Name="MenuRun"       Header="Run"          Click="OnRunProject"    InputGestureText="Ctrl+F5"/>
                <MenuItem x:Name="MenuBuildRun"  Header="Build &amp; Run" Click="OnBuildAndRun" InputGestureText="F5"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Anti-aliasing">
                    <MenuItem x:Name="AaFxaa"  Header="FXAA"    IsCheckable="True" Tag="1" Click="OnAaMenuClick"/>
                    <MenuItem x:Name="AaMsaa2" Header="MSAA 2x" IsCheckable="True" Tag="2" Click="OnAaMenuClick"/>
                    <MenuItem x:Name="AaMsaa4" Header="MSAA 4x" IsCheckable="True" Tag="4" Click="OnAaMenuClick"/>
                    <MenuItem x:Name="AaMsaa8" Header="MSAA 8x" IsCheckable="True" Tag="8" IsChecked="True" Click="OnAaMenuClick"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About ACS Editor" Click="OnAbout"/>
            </MenuItem>
        </Menu>

        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
            <!-- グローバルツールバー: プロジェクト全体の操作のみ (シーン編集ツールはシーンビューへ) -->
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <Button x:Name="PlayBtn"  Content="▶  Play"  Click="OnPlay"  Padding="11,4" Margin="2,0" Foreground="{StaticResource OkFg}"/>
                <Button x:Name="PauseBtn" Content="❚❚ Pause" Click="OnPause" Padding="10,4" Margin="2,0" IsEnabled="False"/>
                <Button x:Name="StepBtn"  Content="▎▶ Step"  Click="OnStep"  Padding="10,4" Margin="2,0" IsEnabled="False"/>
                <ToggleButton x:Name="PreviewBtn" Content="Preview" Click="OnTogglePreview" Padding="10,4" Margin="2,0"/>
                <Button x:Name="BpRunBtn" Content="Blueprints" Click="OnRunBlueprints" Padding="10,4" Margin="2,0"/>
                <Separator/>
                <Button x:Name="BuildBtn" Content="Build" Click="OnBuildProject" Padding="11,4" Margin="2,0"/>
                <Button x:Name="RunBtn" Content="Run" Click="OnBuildAndRun" Padding="11,4" Margin="2,0" Foreground="{StaticResource InfoFg}"/>
                <ToggleButton x:Name="HotReloadBtn" Content="Hot Reload" Click="OnHotReloadToggle" Padding="10,4" Margin="2,0"/>
            </StackPanel>
        </Border>

        <!-- ステータスバー -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Foreground="{StaticResource TextDim}">
            <StatusBarItem><TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" Text="Ready"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock x:Name="ViewportInfo" Foreground="{StaticResource TextDim}" Text=""/></StatusBarItem>
        </StatusBar>

        <!-- 本体: Hierarchy | (Viewport / Console) | Inspector -->
        <Grid Background="{StaticResource Edge}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- 左カラム: Hierarchy -->
            <DockPanel Grid.Column="0" Background="{StaticResource Panel}">
                <TextBlock DockPanel.Dock="Top" Text="Hierarchy" Style="{StaticResource PanelHeader}"/>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Hairline}"/>
                <TextBox x:Name="HierSearchBox" DockPanel.Dock="Top" Margin="4,4,2,2"
                         VerticalContentAlignment="Center" ToolTip="ノード名で検索/フィルタ (一致ノードとその親を表示)"
                         TextChanged="OnHierSearchChanged"/>
                <TreeView x:Name="HierarchyTree" Background="{StaticResource Panel}" Foreground="{StaticResource Text}"
                          BorderThickness="0" Margin="4,4,2,4"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectedItemChanged="OnHierarchySelect">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="空のオブジェクト" Click="OnCtxCreateEmpty"/>
                            <MenuItem x:Name="CtxBuiltin" Header="ビルトインのオブジェクト"/>
                            <MenuItem x:Name="CtxUser" Header="ユーザー定義のオブジェクト"/>
                            <Separator/>
                            <MenuItem Header="Blueprint として保存…" Click="OnCtxSaveBlueprint"/>
                            <MenuItem Header="名前を変更" Click="OnCtxRename"/>
                            <MenuItem Header="複製" Click="OnDuplicateNode" InputGestureText="Ctrl+D"/>
                            <MenuItem Header="削除" Click="OnCtxDelete" InputGestureText="Del"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Edge}"/>

            <!-- 中央: Viewport (上) + Console (下) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition x:Name="BottomDockRow" Height="172"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Background="{StaticResource Edge}">
                    <DockPanel DockPanel.Dock="Top" Background="{StaticResource Panel2}">
                        <ToggleButton x:Name="SceneTabBtn" Content="◳ Scene" IsChecked="True" Click="OnSceneTab"
                                      Padding="12,4" Margin="2" Background="Transparent" Foreground="{StaticResource Text}"/>
                        <ToggleButton x:Name="GameTabBtn" Content="▶ Game" Click="OnGameTab"
                                      Padding="12,4" Margin="2" Background="Transparent" Foreground="{StaticResource Text}"/>
                        <ToggleButton x:Name="BlueprintTabBtn" Content="⛓ Blueprint" Click="OnBlueprintTab"
                                      Padding="12,4" Margin="2" Background="Transparent" Foreground="{StaticResource Text}"/>
                        <!-- シーンビュー専用の編集ツール (右寄せ。グローバルツールバーから移動) -->
                        <StackPanel x:Name="SceneTools" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <ToggleButton x:Name="OrthoBtn" Content="▱ 2D" Click="OnToggleOrtho" Padding="8,3" Margin="1,0"
                                          ToolTip="2D ビュー (正射影・正面) ⇔ 3D 透視 を切替"/>
                            <ToggleButton x:Name="PolyBtn" Content="✎ Polygon" Click="OnPolyToggle" Padding="8,3" Margin="1,0"/>
                            <Separator/>
                            <ToggleButton x:Name="GizMove"   Content="✛" Click="OnGizmoMove"   Padding="8,3" Margin="1,0" ToolTip="Move (W)"/>
                            <ToggleButton x:Name="GizRotate" Content="⟳" Click="OnGizmoRotate" Padding="8,3" Margin="1,0" ToolTip="Rotate (E)"/>
                            <ToggleButton x:Name="GizScale"  Content="⤢" Click="OnGizmoScale"  Padding="8,3" Margin="1,0" ToolTip="Scale (R)"/>
                            <CheckBox x:Name="SnapCheck" Content="Snap" Click="OnSnapToggle" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <Separator/>
                            <Button Content="Focus" Click="OnFocus" Padding="9,3" Margin="1,0"/>
                            <Button Content="Reset" Click="OnResetView" Padding="9,3" Margin="1,0"/>
                            <Separator/>
                            <Menu Background="Transparent" VerticalAlignment="Center" Padding="0">
                                <MenuItem Header="⊞ Align ▾" Padding="7,3" ToolTip="整列・分散">
                                    <MenuItem Header="左揃え"     Click="OnAlignLeft"/>
                                    <MenuItem Header="右揃え"     Click="OnAlignRight"/>
                                    <MenuItem Header="上揃え"     Click="OnAlignTop"/>
                                    <MenuItem Header="下揃え"     Click="OnAlignBottom"/>
                                    <MenuItem Header="水平中央"   Click="OnAlignHC"/>
                                    <MenuItem Header="垂直中央"   Click="OnAlignVC"/>
                                    <Separator/>
                                    <MenuItem Header="水平に分散" Click="OnDistributeH"/>
                                    <MenuItem Header="垂直に分散" Click="OnDistributeV"/>
                                </MenuItem>
                            </Menu>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <Border x:Name="ViewportHost" Background="{StaticResource Edge}" Margin="0"/>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource Edge}"/>

                <Grid Grid.Row="2" Background="{StaticResource Panel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- 下部パネルのタブ見出し + ログのフィルタ/検索/ソート -->
                    <DockPanel Grid.Row="0" Background="{StaticResource Panel2}">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <ToggleButton x:Name="TabConsole" Content="Console" IsChecked="True"
                                          Padding="12,5" Margin="2" Click="OnBottomTab" Tag="console"/>
                            <ToggleButton x:Name="TabBuild" Content="Build"
                                          Padding="12,5" Margin="2" Click="OnBottomTab" Tag="build"/>
                            <ToggleButton x:Name="TabAssets" Content="Assets"
                                          Padding="12,5" Margin="2" Click="OnBottomTab" Tag="assets"/>
                        </StackPanel>
                        <!-- 右: ログツールバー (Console タブのときだけ表示) -->
                        <StackPanel x:Name="LogToolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBox x:Name="LogSearch" Width="150" Height="22" Padding="6,2" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" TextChanged="OnLogFilterChanged"
                                     ToolTip="ログを文字列で絞り込み"/>
                            <ToggleButton x:Name="FltInfo"  Content="Info"  IsChecked="True" Padding="7,3" Margin="1,0" Click="OnLogFilterChanged" Tag="info"/>
                            <ToggleButton x:Name="FltWarn"  Content="Warn"  IsChecked="True" Padding="7,3" Margin="1,0" Click="OnLogFilterChanged" Tag="warn"/>
                            <ToggleButton x:Name="FltError" Content="Error" IsChecked="True" Padding="7,3" Margin="1,0" Click="OnLogFilterChanged" Tag="error"/>
                            <ToggleButton x:Name="SortNewest" Content="↓ New" Padding="7,3" Margin="6,0,0,0" Click="OnLogSortToggle"
                                          ToolTip="新しい順 / 古い順を切替"/>
                            <Button Content="Clear" Padding="8,3" Margin="6,0,0,0" Click="OnClearLog"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="ConsoleList" Grid.Row="1" Background="{StaticResource Panel2}"
                             BorderThickness="0" FontSize="12" Margin="4"
                             SelectionMode="Extended" KeyDown="OnConsoleKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="コピー (選択行)" Click="OnCopyLog" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="すべてコピー"   Click="OnCopyAllLog"/>
                                <Separator/>
                                <MenuItem Header="クリア"         Click="OnClearLog"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextDim}" FontFamily="Consolas" Width="62" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource LogChip}" Background="{Binding ChipBrush}">
                                        <TextBlock Text="{Binding Tag}" Foreground="{Binding ChipFg}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding MsgBrush}" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="BuildList" Grid.Row="1" Background="{StaticResource Panel2}" Foreground="#FFB7BEC8"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12" Margin="4" Visibility="Collapsed"
                             SelectionMode="Extended" KeyDown="OnBuildKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="コピー (選択行)" Click="OnCopyBuild" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="すべてコピー"   Click="OnCopyAllBuild"/>
                                <Separator/>
                                <MenuItem Header="クリア"         Click="OnClearBuild"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontFamily="Consolas"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <local:AssetBrowserPanel x:Name="AssetBrowser" Grid.Row="1" Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource Edge}"/>

            <!-- Inspector -->
            <DockPanel Grid.Column="4" Background="{StaticResource Panel}">
                <TextBlock DockPanel.Dock="Top" Text="Inspector" Style="{StaticResource PanelHeader}"/>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource Hairline}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
                    <StackPanel Margin="12,10">
                        <!-- 選択ノードのヘッダ -->
                        <Border Background="{StaticResource Panel2}" CornerRadius="0" Padding="10,8" Margin="0,0,0,4">
                            <StackPanel>
                                <!-- オブジェクト名 + 有効(Enabled) トグル (名前の横)。3D ノード選択時のみ表示。 -->
                                <DockPanel LastChildFill="True">
                                    <CheckBox x:Name="InspEnabled" DockPanel.Dock="Right" Content="Enabled" Visibility="Collapsed"
                                              VerticalAlignment="Center" Foreground="{StaticResource Text}" Margin="8,0,0,0"
                                              Checked="OnInspEnabledChanged" Unchecked="OnInspEnabledChanged" ToolTip="有効 (Enabled)"/>
                                    <TextBlock x:Name="InspName" Text="(no selection)" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="InspSub" Text="ノードを選択してください" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 3D ノードの Inspector (3D モードで動的生成。2D の InspFields は隠す)。 -->
                        <StackPanel x:Name="Insp3DPanel" Visibility="Collapsed"/>

                        <StackPanel x:Name="InspFields" IsEnabled="False">
                            <Grid Style="{StaticResource SectionHeader}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="TRANSFORM" Style="{StaticResource Section}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource NumBox}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Position" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="PosX" Grid.Column="1" Style="{StaticResource NumBox}" Margin="0,0,3,0"/>
                                <TextBox x:Name="PosY" Grid.Column="2" Style="{StaticResource NumBox}" Margin="3,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Rotation°" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="RotDeg" Grid.Column="1" Style="{StaticResource NumBox}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Scale" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ScaleX" Grid.Column="1" Style="{StaticResource NumBox}" Margin="0,0,3,0"/>
                                <TextBox x:Name="ScaleY" Grid.Column="2" Style="{StaticResource NumBox}" Margin="3,0,0,0"/>
                            </Grid>

                            <Grid Style="{StaticResource SectionHeader}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="DISPLAY" Style="{StaticResource Section}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <CheckBox x:Name="DispVisible" Content="Visible" Margin="0,0,18,0" Click="OnDispVisible"/>
                                <CheckBox x:Name="DispEnabled" Content="Enabled" Click="OnDispEnabled"/>
                            </StackPanel>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Sort Layer" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DispLayer" Grid.Column="1" Style="{StaticResource NumBox}" Margin="0,0,8,0"/>
                                <TextBlock Text="Base" Grid.Column="2" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DispBase" Grid.Column="3" Style="{StaticResource NumBox}"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="ColR" Width="40" Margin="0,0,3,0" Style="{StaticResource NumBox}"/>
                                    <TextBox x:Name="ColG" Width="40" Margin="0,0,3,0" Style="{StaticResource NumBox}"/>
                                    <TextBox x:Name="ColB" Width="40" Margin="0,0,3,0" Style="{StaticResource NumBox}"/>
                                    <TextBox x:Name="ColA" Width="40" Style="{StaticResource NumBox}"/>
                                </StackPanel>
                                <Border x:Name="ColorSwatch" Grid.Column="2" Width="26" Height="26" CornerRadius="0"
                                        Background="#FF888888" BorderBrush="{StaticResource Edge}" BorderThickness="1" Margin="6,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Sprite" Style="{StaticResource FieldLabel}"/>
                                <TextBlock x:Name="SpriteLabel" Grid.Column="1" Text="(なし)" Foreground="{StaticResource TextDim}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="…" Click="OnBrowseSprite" Padding="9,2" Margin="0,0,4,0"/>
                                    <Button Content="✕" Click="OnClearSprite" Padding="7,2" Foreground="{StaticResource WarnFg}"/>
                                </StackPanel>
                            </Grid>

                            <!-- マテリアル (効果プリセット)。ノードは選ぶだけ。効果の編集はマテリアルエディタで。 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Material" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="MaterialBox" Grid.Column="1" SelectionChanged="OnMaterialSelected" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="✎" Click="OnEditMaterial" Padding="7,2" Margin="0,0,4,0" ToolTip="編集" Foreground="{StaticResource InfoFg}"/>
                                    <Button Content="+" Click="OnNewMaterial" Padding="7,2" Margin="0,0,4,0" ToolTip="新規マテリアルを作成" Foreground="{StaticResource OkFg}"/>
                                    <Button Content="✕" Click="OnClearMaterial" Padding="7,2" ToolTip="マテリアルを外す" Foreground="{StaticResource WarnFg}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Style="{StaticResource SectionHeader}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="COMPONENTS" Style="{StaticResource Section}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Height="1" Background="{StaticResource Hairline}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel x:Name="CompList"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CompAddBox" Grid.Column="0"/>
                                <Button Grid.Column="1" Content="+ Add" Click="OnAddComponent" Margin="6,0,0,0" Padding="10,4" Foreground="{StaticResource OkFg}"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock x:Name="MultiHint" Visibility="Collapsed" Foreground="{StaticResource TextDim}"
                                   Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                   Text="複数選択中: transform 編集は単一選択時のみ。Duplicate / Delete は選択全体に効きます。"/>

                        <StackPanel x:Name="ActionButtons" Orientation="Horizontal" Margin="0,14,0,0" IsEnabled="False">
                            <Button Content="Duplicate" Click="OnDuplicateNode" Padding="10,5" Margin="0,0,6,0" Foreground="{StaticResource LinkFg}"/>
                            <Button x:Name="DeleteBtn" Content="Delete" Click="OnDeleteNode" Padding="10,5" Foreground="{StaticResource WarnFg}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
