<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>acsbuild</AssemblyName>
    <RootNamespace>Acs.Build</RootNamespace>
  </PropertyGroup>

  <!-- src/**/*.Build.cs を tool の compile input へ取り込み、実行時の型列挙で AcsModule 定義を検出する。 -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\src\**\*.Build.cs">
      <Link>Modules\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
