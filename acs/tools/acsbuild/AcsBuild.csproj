<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>acsbuild</AssemblyName>
    <RootNamespace>Acs.Build</RootNamespace>
  </PropertyGroup>

  <!-- 各モジュールの *.Build.cs を本ツールへコンパイル取り込み
       (UE の UnrealBuildTool が *.Build.cs を集めて評価するのと同じ役割)。
       新しいモジュールの Build.cs を足したら再ビルドで自動的に拾われる。 -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\src\**\*.Build.cs">
      <Link>Modules\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
