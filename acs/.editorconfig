# ============================================================================
# ACS editor config (Phase 0 / Option A+).
# Honored by VS 2022, Rider, CLion, VSCode, Neovim/coc, Emacs/lsp-mode.
# ============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{h,hpp,c,cc,cpp,inl}]
indent_size = 4
max_line_length = 120

[*.{hlsl,fx,fxh,shader,glsl}]
indent_size = 4
max_line_length = 120

[*.{cmake,CMakeLists.txt}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false   # Markdown trailing-double-space line breaks

[*.{bat,cmd}]
end_of_line = crlf

[*.{ps1,psm1,psd1}]
end_of_line = crlf

[Makefile]
indent_style = tab
